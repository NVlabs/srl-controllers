    case Kind::torque_filter_value: {
      result = validate_input(call, 0, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 1, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 2, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 3, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 4, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 5, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 6, 0, DType::kBool);
      if (!result.ok()) return result;
      result = validate_output(call, 0, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_output(call, 1, 0, DType::kBool);
      if (!result.ok()) return result;
      return validate_disjoint(call, 7, 2);
    }
    case Kind::safe_output_value: {
      result = validate_input(call, 0, 0, DType::kBool);
      if (!result.ok()) return result;
      result = validate_input(call, 1, 0, DType::kBool);
      if (!result.ok()) return result;
      result = validate_input(call, 2, 0, DType::kBool);
      if (!result.ok()) return result;
      result = validate_input(call, 3, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_input(call, 4, 0, call.dtype);
      if (!result.ok()) return result;
      result = validate_output(call, 0, 0, call.dtype);
      if (!result.ok()) return result;
      return validate_disjoint(call, 5, 1);
