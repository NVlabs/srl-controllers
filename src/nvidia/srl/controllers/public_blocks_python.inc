inline py::tuple describe_requirements(const Requirements& requirements) {
  auto describe = [](const auto& descriptors, std::size_t count) {
    py::list items;
    for (std::size_t index = 0; index < count; ++index) {
      const auto& item = descriptors[index];
      py::list shape;
      for (int axis = 0; axis < item.rank; ++axis) shape.append(item.shape[axis]);
      const char* dtype = item.dtype == DType::kFloat32   ? "float32"
                          : item.dtype == DType::kFloat64 ? "float64"
                          : item.dtype == DType::kBool    ? "bool"
                                                          : "uint64";
      items.append(py::make_tuple(item.name, dtype, py::tuple(shape), item.units, item.frame));
    }
    return py::tuple(items);
  };
  return py::make_tuple(requirements.batch_size,
                        requirements.joint_dim,
                        describe(requirements.outputs, requirements.output_count),
                        describe(requirements.state, requirements.state_count),
                        describe(requirements.scratch, requirements.scratch_count));
}
