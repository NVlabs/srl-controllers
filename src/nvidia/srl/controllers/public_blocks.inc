Result CartesianDamping::requirements(const Config& config, Requirements* output) noexcept {
  if (!output) return invalid_argument("requirements output is null");
  *output = Requirements{};
  const ControllerConfig c = block_config(config);
  const std::size_t dimension = block_dimension(config);
  (void)dimension;
  Result result = validate_cartesian_config(c, false);
  if (!result.ok()) return result;
  output->batch_size = c.batch_size;
  output->joint_dim = c.joint_dim;
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.command",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size, 6},
                                    "N_then_Nm",
                                    cartesian_frame_name(c.cartesian_frame));
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.parameter_status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_safety_requirements(c, 6, "caller_defined", "caller_defined", output);
  if (!result.ok()) return result;
  output->state[output->state_count - 3].name = "output.safety.last_valid_output";
  output->state[output->state_count - 2].name = "output.safety.valid_mask";
  output->state[output->state_count - 1].name = "output.safety.hold_count";
  return {};
}
