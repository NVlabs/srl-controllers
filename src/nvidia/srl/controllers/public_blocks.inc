Result EnergyTank::requirements(const Config& config, Requirements* output) noexcept {
  if (!output) return invalid_argument("requirements output is null");
  *output = Requirements{};
  const ControllerConfig c = block_config(config);
  const std::size_t dimension = block_dimension(config);
  (void)dimension;
  Result result = validate_config(c, false);
  if (!result.ok()) return result;
  if (dimension == 0) return invalid_argument("signal_dim must be positive");
  if (dimension != 1) return invalid_argument("energy tank uses signal_dim == 1");
  output->batch_size = c.batch_size;
  output->joint_dim = c.joint_dim;
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "scale",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size},
                                    "unitless",
                                    "caller_defined");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "filtered_power",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size},
                                    "W",
                                    "caller_defined");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->state,
                                    &output->state_count,
                                    "state.state_variable",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size},
                                    "sqrt(J)",
                                    "caller_defined");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "parameter_status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  return {};
}
Result EnergyTank::prepare(const Config& config,
                           const Parameters& parameters,
                           const Storage& storage,
                           ExecutionContext context) noexcept {
  prepared_ = false;
  Requirements description;
  Result result = requirements(config, &description);
  if (!result.ok()) return result;
  const ControllerConfig c = block_config(config);
  const std::size_t dimension = block_dimension(config);
  (void)dimension;
  result = validate_block_status(c, storage.parameter_status, storage.status);
  if (!result.ok()) return result;
  result = validate_block_array(storage.scale, c, c.dtype, {c.batch_size});
  if (!result.ok()) return result;
  result = validate_block_array(storage.filtered_power, c, c.dtype, {c.batch_size});
  if (!result.ok()) return result;
  result = validate_block_array(storage.state.state_variable, c, c.dtype, {c.batch_size});
  if (!result.ok()) return result;
  if (block_arrays_overlap({storage.scale,
                            storage.filtered_power,
                            storage.state.state_variable,
                            write_view(storage.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage.status.flags, c.device, c.batch_size)}))
    return invalid_view("mutable block storage must not overlap");
  config_ = config;
  parameters_ = parameters;
  storage_ = storage;
  prepared_ = true;
  result = apply_parameters(parameters, context);
  prepared_ = result.ok();
  return result;
}
Result EnergyTank::apply_parameters(const Parameters& parameters,
                                    ExecutionContext context) noexcept {
  if (!prepared_) return invalid_argument("block is not prepared");
  const ControllerConfig c = block_config(config_);
  const std::size_t dimension = block_dimension(config_);
  (void)dimension;
  std::array<ParameterView, 5> parameter_entries{};
  std::size_t parameter_count = 0;
  append_parameter(
      &parameter_entries, &parameter_count, "upper_energy_limit", parameters.upper_energy_limit);
  append_parameter(
      &parameter_entries, &parameter_count, "lower_energy_limit", parameters.lower_energy_limit);
  append_parameter(
      &parameter_entries, &parameter_count, "initial_energy", parameters.initial_energy);
  append_parameter(
      &parameter_entries, &parameter_count, "empty_threshold", parameters.empty_threshold);
  append_parameter(&parameter_entries, &parameter_count, "power_noise", parameters.power_noise);
  const auto parameters_view = parameter_set(parameter_entries, parameter_count);
  (void)parameters_view;
  std::array<StateEntryView, 1> state_entries{
      {StateEntryView{"state_variable", storage_.state.state_variable}}};
  StateView state{state_entries.data(), state_entries.size()};
  (void)state;
  std::array<ScratchEntryView, 0> scratch_entries{{

  }};
  ScratchView scratch{scratch_entries.data(), scratch_entries.size()};
  (void)scratch;
  (void)c;
  detail::tensor::ScopedTensorExecutionContext scope(context);
  {
    const Result checked = validate_block_parameter(parameters.upper_energy_limit, c, {});
    if (!checked.ok()) {
      prepared_ = false;
      return checked;
    }
  }
  {
    const Result checked = validate_block_parameter(parameters.lower_energy_limit, c, {});
    if (!checked.ok()) {
      prepared_ = false;
      return checked;
    }
  }
  {
    const Result checked = validate_block_parameter(parameters.initial_energy, c, {});
    if (!checked.ok()) {
      prepared_ = false;
      return checked;
    }
  }
  {
    const Result checked = validate_block_parameter(parameters.empty_threshold, c, {});
    if (!checked.ok()) {
      prepared_ = false;
      return checked;
    }
  }
  {
    const Result checked = validate_block_parameter(parameters.power_noise, c, {});
    if (!checked.ok()) {
      prepared_ = false;
      return checked;
    }
  }
  if (block_input_overlaps(parameters.upper_energy_limit.values,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)})) {
    prepared_ = false;
    return invalid_view("parameters must not overlap mutable storage");
  }
  if (block_input_overlaps(parameters.lower_energy_limit.values,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)})) {
    prepared_ = false;
    return invalid_view("parameters must not overlap mutable storage");
  }
  if (block_input_overlaps(parameters.initial_energy.values,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)})) {
    prepared_ = false;
    return invalid_view("parameters must not overlap mutable storage");
  }
  if (block_input_overlaps(parameters.empty_threshold.values,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)})) {
    prepared_ = false;
    return invalid_view("parameters must not overlap mutable storage");
  }
  if (block_input_overlaps(parameters.power_noise.values,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)})) {
    prepared_ = false;
    return invalid_view("parameters must not overlap mutable storage");
  }
  const Result result = detail::tensor::apply_energy_tank_parameters(
      parameters_view, c.batch_size, storage_.parameter_status);
  prepared_ = result.ok();
  if (prepared_) parameters_ = parameters;
  return result;
}
