Result VariableCartesianUnifiedForceImpedanceController::prepare(
    const Config& config,
    const Parameters& parameters,
    const Storage& storage,
    ExecutionContext context) noexcept {
  prepared_ = false;
  Requirements description;
  Result result = requirements(config, &description);
  if (!result.ok()) return result;
  const ControllerConfig c = block_config(config);
  const std::size_t dimension = block_dimension(config);
  (void)dimension;
  result = validate_storage(c, storage.output, 6);
  if (!result.ok()) return result;
  result = validate_block_array(
      storage.state.current_stiffness_matrix, c, c.dtype, {c.batch_size, 6, 6});
  if (!result.ok()) return result;
  result = validate_block_array(
      storage.state.previous_stiffness_matrix, c, c.dtype, {c.batch_size, 6, 6});
  if (!result.ok()) return result;
  result =
      validate_block_array(storage.state.stiffness_initialized, c, DType::kBool, {c.batch_size});
  if (!result.ok()) return result;
  result =
      validate_block_array(storage.state.previous_mass_matrix, c, c.dtype, {c.batch_size, 6, 6});
  if (!result.ok()) return result;
  result = validate_block_array(
      storage.state.previous_jacobian, c, c.dtype, {c.batch_size, 6, c.joint_dim});
  if (!result.ok()) return result;
  result =
      validate_block_array(storage.state.inertial_initialized, c, DType::kBool, {c.batch_size});
  if (!result.ok()) return result;
  result = validate_block_array(
      storage.state.differentiator_previous_error, c, c.dtype, {c.batch_size, 6});
  if (!result.ok()) return result;
  result =
