          inputs.goal_pose,
          {storage_.output.command,
           storage_.output.safety.last_valid_output,
           storage_.output.safety.valid_mask,
           storage_.output.safety.hold_count,
           write_view(storage_.output.parameter_status.flags, c.device, c.batch_size),
           write_view(storage_.output.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  if (block_input_overlaps(
          inputs.cartesian_twist,
          {storage_.output.command,
           storage_.output.safety.last_valid_output,
           storage_.output.safety.valid_mask,
           storage_.output.safety.hold_count,
           write_view(storage_.output.parameter_status.flags, c.device, c.batch_size),
           write_view(storage_.output.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  const Result result =
      detail::tensor::step_inverse_apf(inputs.current_pose,
                                       inputs.goal_pose,
                                       inputs.cartesian_twist,
                                       parameters_view,
                                       read_status(storage_.output.parameter_status),
                                       storage_.output.command,
                                       storage_.output.status);
  return finish_step(result, c, storage_.output);
}

Result InertialCoupling::requirements(const Config& config, Requirements* output) noexcept {
  if (!output) return invalid_argument("requirements output is null");
  *output = Requirements{};
  const ControllerConfig c = block_config(config);
  const std::size_t dimension = block_dimension(config);
  (void)dimension;
  Result result = validate_cartesian_config(c, true);
  if (!result.ok()) return result;
  output->batch_size = c.batch_size;
  output->joint_dim = c.joint_dim;
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.command",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size, 6},
                                    "N_then_Nm",
                                    cartesian_frame_name(c.cartesian_frame));
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->state,
                                    &output->state_count,
                                    "state.previous_mass_matrix",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size, 6, 6},
                                    "caller_defined",
                                    cartesian_frame_name(c.cartesian_frame));
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->state,
                                    &output->state_count,
                                    "state.previous_jacobian",
                                    c.dtype,
                                    c.device,
                                    {c.batch_size, 6, c.joint_dim},
                                    "caller_defined",
                                    cartesian_frame_name(c.cartesian_frame));
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->state,
                                    &output->state_count,
                                    "state.initialized",
                                    DType::kBool,
                                    c.device,
                                    {c.batch_size},
                                    "caller_defined",
                                    cartesian_frame_name(c.cartesian_frame));
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.parameter_status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_block_requirement(&output->outputs,
                                    &output->output_count,
                                    "output.status",
                                    DType::kUInt64,
                                    c.device,
                                    {c.batch_size},
                                    "status_flags",
                                    "none");
  if (!result.ok()) {
    *output = Requirements{};
    return result;
  }
  result = append_safety_requirements(c, 6, "caller_defined", "caller_defined", output);
  if (!result.ok()) return result;
  output->state[output->state_count - 3].name = "output.safety.last_valid_output";
  output->state[output->state_count - 2].name = "output.safety.valid_mask";
  output->state[output->state_count - 1].name = "output.safety.hold_count";
  return {};
}
