           storage.scratch.variable_impedance_status,
           storage.scratch.force_status,
           storage.output.command,
           storage.output.safety.last_valid_output,
           storage.output.safety.valid_mask,
           storage.output.safety.hold_count,
           write_view(storage.output.parameter_status.flags, c.device, c.batch_size),
           write_view(storage.output.status.flags, c.device, c.batch_size)}))
