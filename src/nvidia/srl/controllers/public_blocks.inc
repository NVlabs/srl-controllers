           storage_.scratch.inertial_wrench,
           storage_.scratch.stiffness_status,
           storage_.scratch.damping_status,
           storage_.scratch.inertial_status,
           storage_.scratch.variable_impedance_wrench,
           storage_.scratch.force_wrench,
           storage_.scratch.variable_impedance_status,
           storage_.scratch.force_status,
           storage_.output.command,
           storage_.output.safety.last_valid_output,
           storage_.output.safety.valid_mask,
           storage_.output.safety.hold_count,
           write_view(storage_.output.parameter_status.flags, c.device, c.batch_size),
           write_view(storage_.output.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  const Result result = detail::tensor::step_variable_cartesian_unified_force_impedance_controller(
      inputs.cartesian_pose_error,
      inputs.stiffness_matrix,
      inputs.cartesian_velocity_error,
      inputs.desired_acceleration,
      inputs.joint_velocity,
      inputs.cartesian_mass_matrix,
      inputs.jacobian,
      inputs.external_wrench,
      inputs.desired_wrench,
      inputs.feedforward_wrench,
      inputs.dt,
      config_.use_shaping_function,
      parameters_view,
      read_status(storage_.output.parameter_status),
      state,
      scratch,
      storage_.output.command,
      storage_.output.status);
  return finish_step(result, c, storage_.output);
}
