Result EnergyTank::step(const Inputs& inputs, ExecutionContext context) noexcept {
  if (!prepared_) return invalid_argument("block is not prepared");
  const ControllerConfig c = block_config(config_);
  const std::size_t dimension = block_dimension(config_);
  (void)dimension;
  std::array<ParameterView, 5> parameter_entries{};
  std::size_t parameter_count = 0;
  append_parameter(
      &parameter_entries, &parameter_count, "upper_energy_limit", parameters_.upper_energy_limit);
  append_parameter(
      &parameter_entries, &parameter_count, "lower_energy_limit", parameters_.lower_energy_limit);
  append_parameter(
      &parameter_entries, &parameter_count, "initial_energy", parameters_.initial_energy);
  append_parameter(
      &parameter_entries, &parameter_count, "empty_threshold", parameters_.empty_threshold);
  append_parameter(&parameter_entries, &parameter_count, "power_noise", parameters_.power_noise);
  const auto parameters_view = parameter_set(parameter_entries, parameter_count);
  (void)parameters_view;
  std::array<StateEntryView, 1> state_entries{
      {StateEntryView{"state_variable", storage_.state.state_variable}}};
  StateView state{state_entries.data(), state_entries.size()};
  (void)state;
  std::array<ScratchEntryView, 0> scratch_entries{{

  }};
  ScratchView scratch{scratch_entries.data(), scratch_entries.size()};
  (void)scratch;
  (void)c;
  detail::tensor::ScopedTensorExecutionContext scope(context);
  {
    const Result checked = validate_block_array(inputs.power_signal, c, c.dtype, {c.batch_size});
    if (!checked.ok()) return checked;
  }
  {
    const Result checked =
        validate_block_array(inputs.additional_power, c, c.dtype, {c.batch_size});
    if (!checked.ok()) return checked;
  }
  {
    const Result checked = validate_block_dt(inputs.dt, c);
    if (!checked.ok()) return checked;
  }
  if (block_input_overlaps(inputs.power_signal,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  if (block_input_overlaps(inputs.additional_power,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  if (block_input_overlaps(inputs.dt,
                           {storage_.scale,
                            storage_.filtered_power,
                            storage_.state.state_variable,
                            write_view(storage_.parameter_status.flags, c.device, c.batch_size),
                            write_view(storage_.status.flags, c.device, c.batch_size)}))
    return invalid_view("inputs must not overlap mutable storage");
  const Result result = detail::tensor::step_energy_tank(inputs.power_signal,
                                                         inputs.additional_power,
                                                         inputs.dt,
                                                         parameters_view,
                                                         read_status(storage_.parameter_status),
                                                         state,
                                                         storage_.scale,
                                                         storage_.filtered_power,
                                                         storage_.status);
  return result;
}

