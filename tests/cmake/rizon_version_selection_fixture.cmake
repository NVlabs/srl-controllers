if(NOT DEFINED VERSION_MODULE OR "${VERSION_MODULE}" STREQUAL "" OR
   NOT DEFINED SELECTED_VERSION OR "${SELECTED_VERSION}" STREQUAL "")
  message(FATAL_ERROR "VERSION_MODULE and SELECTED_VERSION are required")
endif()

include("${VERSION_MODULE}")
nvidia_srl_controllers_select_flexiv_rdk_version("${SELECTED_VERSION}")
message(STATUS
  "RDK_SELECTION=${SELECTED_VERSION}|${FLEXIV_RDK_GIT_REVISION}|"
  "${FLEXIV_RDK_LINUX_X86_64_SHA256}|${FLEXIV_RDK_ASSET_NAME}|"
  "${FLEXIV_RDK_INSTALLED_LIBRARY}|${FLEXIV_RDK_INSTALL_KIND}|"
  "${FLEXIV_RDK_REQUIRES_DEPENDENCIES}")
