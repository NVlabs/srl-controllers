if(NOT DEFINED CONTROLLERS_SOURCE_DIR OR NOT DEFINED TEST_BINARY_DIR OR
   "${CONTROLLERS_SOURCE_DIR}" STREQUAL "" OR "${TEST_BINARY_DIR}" STREQUAL "")
  message(FATAL_ERROR "CONTROLLERS_SOURCE_DIR and TEST_BINARY_DIR are required")
endif()

file(REMOVE_RECURSE "${TEST_BINARY_DIR}")
set(CONFIGURE_COMMAND
  "${CMAKE_COMMAND}"
  -S "${CONTROLLERS_SOURCE_DIR}"
  -B "${TEST_BINARY_DIR}"
  -DENABLE_EXAMPLES=ON
  -DENABLE_FLEXIV_DUAL_ARM_RDK_EXAMPLE=OFF
  -DENABLE_TESTS=OFF
  -DENABLE_PYBIND=OFF
  -DENABLE_DOCS=OFF
  -DENABLE_COVERAGE=OFF
  -DENABLE_TOOLS=OFF
  -DDEVEL=OFF)
if(DEFINED TEST_CMAKE_GENERATOR AND NOT "${TEST_CMAKE_GENERATOR}" STREQUAL "")
  list(APPEND CONFIGURE_COMMAND -G "${TEST_CMAKE_GENERATOR}")
endif()
if(DEFINED TEST_CMAKE_MAKE_PROGRAM AND NOT "${TEST_CMAKE_MAKE_PROGRAM}" STREQUAL "")
  list(APPEND CONFIGURE_COMMAND "-DCMAKE_MAKE_PROGRAM=${TEST_CMAKE_MAKE_PROGRAM}")
endif()

execute_process(
  COMMAND ${CONFIGURE_COMMAND}
  RESULT_VARIABLE CONFIGURE_RESULT
  OUTPUT_VARIABLE CONFIGURE_OUTPUT
  ERROR_VARIABLE CONFIGURE_ERROR)
if(NOT CONFIGURE_RESULT EQUAL 0)
  message(FATAL_ERROR
    "Configuration with ENABLE_FLEXIV_DUAL_ARM_RDK_EXAMPLE=OFF failed:\n"
    "${CONFIGURE_OUTPUT}\n${CONFIGURE_ERROR}")
endif()
if(EXISTS "${TEST_BINARY_DIR}/_deps/flexiv_rdk-2.0" OR
   CONFIGURE_OUTPUT MATCHES "Downloading.*flexiv_rdk")
  message(FATAL_ERROR "Flexiv RDK v2 was accessed while its example option was OFF")
endif()
